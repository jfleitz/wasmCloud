package wpf:core@0.1.0;

/// Cross-component event bus.
///
/// Components publish events with `post`. The runtime delivers them to every
/// component whose `subscribe` pattern matches. Patterns are MPF-style globs:
/// `mode_*_started`, `s_left_flipper_active`, `*` (everything).
interface events {
    record event {
        name: string,
        priority: s32,
        payload: list<tuple<string, string>>,
        origin: string,
    }

    post: func(ev: event);
    subscribe: func(pattern: string) -> result<_, string>;
}

/// Logical device control. Implemented by `device-manager`; consumed by every
/// component that wants to drive a coil, set a light, or read a switch.
///
/// Devices are addressed by name (the YAML key, e.g. `c_left_flipper`). The
/// device-manager translates the name to the hardware-level `coil-id` /
/// `switch-id` / `light-id` understood by the `wpf:hardware` plugin.
interface devices {
    enum device-kind {
        switch-kind,
        coil,
        light,
        flipper,
        autofire,
        ball-device,
        drop-target,
        diverter,
    }

    record device-ref {
        name: string,
        kind: device-kind,
    }

    /// Build the device registry from a canonical MachineConfig (the JSON
    /// blob produced by config-loader), program firmware-resident autofire
    /// rules for every flipper, and start the hardware event pump. Called by
    /// the game driver after the config loads — the `devices`-flavored
    /// equivalent of `lifecycle.boot` (which stays for hosts that invoke
    /// lifecycle directly; both run the same code). Idempotent: reconfiguring
    /// rebuilds the registry and re-arms autofire without duplicating the
    /// event pump.
    configure:     func(machine-config: list<u8>) -> result<_, string>;

    /// Pull up to `max-events` buffered hardware events, translate each into
    /// its logical bus event (`<switch-name>_active` / `_inactive`,
    /// `hw_link_up`, ...), post them, and return how many were handled. The
    /// game driver calls this every tick — it is the machine's switch pump.
    poll-hardware: func(max-events: u32) -> result<u32, string>;

    pulse-coil:    func(name: string, ms: u32) -> result<_, string>;
    enable-coil:   func(name: string) -> result<_, string>;
    disable-coil:  func(name: string) -> result<_, string>;
    set-light:     func(name: string, rgb: tuple<u8, u8, u8>) -> result<_, string>;

    /// Batch light update — one call per show frame. Names that don't resolve
    /// to a light are skipped. Preferred over repeated `set-light` when many
    /// LEDs change at once: device-manager forwards it as a single
    /// `wpf:hardware/lights.set-lights`, one hardware round trip.
    set-lights:    func(updates: list<tuple<string, tuple<u8, u8, u8>>>) -> result<_, string>;

    switch-state:  func(name: string) -> result<bool, string>;
    list-devices:  func() -> list<device-ref>;
}

/// Mode lifecycle. Exported by `mode-runner`.
interface modes {
    start:  func(mode-name: string, config: list<u8>);
    stop:   func(mode-name: string);
    active: func() -> list<string>;
}

/// Backbox Control Protocol bridge. Exported by `mc-bridge`. `audio-player`,
/// `lighting-show-player`, `core-engine` send slide / sound / variable updates
/// out to a media controller (typically Godot MC).
interface bcp {
    record bcp-message {
        cmd: string,
        params: list<tuple<string, string>>,
    }

    send: func(msg: bcp-message);
}

/// Lifecycle hook for components that want a one-shot init at machine startup.
/// `core-engine` invokes `boot` on every component that exports it after the
/// MachineConfig has been broadcast.
interface lifecycle {
    boot:     func(machine-config: list<u8>) -> result<_, string>;
    shutdown: func();
}

world wpf-component {
    import events;
    import devices;
    import bcp;
    export lifecycle;
}

world wpf-mode-component {
    import events;
    import devices;
    import bcp;
    export lifecycle;
    export modes;
}
